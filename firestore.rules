rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar autenticação
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função auxiliar para verificar se o usuário é o dono do registro
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Regras para a coleção principal de usuários ('usuarios')
    match /usuarios/{userId} {
      allow read, write: if isOwner(userId);

      // Subcoleções do usuário: 'diario', 'historico_ferramentas', etc.
      match /{subcolecao}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Regras de compatibilidade caso utilize 'users'
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcolecao}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
